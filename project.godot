; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Fnaf sister location replication"
run/main_scene="uid://lshfkeydhqek"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
config/icon="uid://c58bl0363folj"
boot_splash/show_image=false
boot_splash/use_filter=false

[display]

window/size/mode=3
window/size/borderless=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale=0.78

[editor]

export/convert_text_resources_to_binary=false
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/asset_includer_/plugin.cfg", "res://addons/ehehh/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=2
rendering_device/driver.windows="d3d12"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_s3tc_bptc=true
textures/lossless_compression/force_png=true
textures/default_filters/default_texture_filter=3
